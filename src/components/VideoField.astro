---
import { heroVideo } from "../data/content";

interface Props {
  /** Clip URL. Every instance shares one file by default, so it downloads once. */
  src?: string;
  /** Extra classes on the wrapper. */
  class?: string;
  /** Opacity once the footage is live. Secondary sections want this low. */
  opacity?: number;
  /** Seconds of dissolve across the loop wrap. */
  dissolve?: number;
  /** Playback rate. Slower means fewer wraps to hide. */
  pace?: number;
  /** Cursor-follow warmth. */
  presence?: boolean;
  /** Ink veil above the footage, for sections with text over it. */
  veil?: boolean;
  /** Resting filter. */
  saturate?: number;
  brightness?: number;
  /** Strength of the shadow-lift pass. */
  lift?: number;
  /**
   * Load immediately. Exactly one field per page should be eager (the hero).
   * Everything else attaches its source only when it scrolls close, so a phone
   * isn't buffering the same clip in several decoders at once.
   */
  eager?: boolean;
  /**
   * Still frame shown instantly while video loads. On narrow viewports with
   * no mobileSrc given, this is left in place permanently instead of video.
   */
  poster?: string;
  /**
   * Smaller, lighter clip for narrow viewports — same footage, downscaled
   * and re-encoded, so a phone still gets the animated background without
   * paying for the full desktop source. Plays as a single native loop (no
   * crossfade decoder, no second copy) to keep the cost down further. Omit
   * to fall back to the poster-only (no video) behavior on mobile.
   */
  mobileSrc?: string;
}

const {
  src = heroVideo.src,
  class: className = "",
  opacity = 1,
  dissolve = heroVideo.dissolve,
  pace = heroVideo.pace,
  presence = true,
  veil = false,
  saturate = 1.15,
  brightness = 0.96,
  lift = 0.3,
  eager = false,
  poster,
  mobileSrc,
} = Astro.props;
---

<div
  class:list={["video-field", className]}
  data-video-field
  data-dissolve={String(dissolve)}
  data-pace={String(pace)}
  data-presence={presence ? "1" : "0"}
  data-eager={eager ? "1" : "0"}
  data-src={src}
  data-mobile-src={mobileSrc}
  aria-hidden="true"
  style={`--vf-sat:${saturate}; --vf-bri:${brightness}; --vf-lift:${lift}; --vf-opacity:${opacity}`}
>
  <div class="video-field__stack">
    <video
      class="video-field__v"
      data-vf-a
      poster={poster}
      muted
      playsinline
      preload="none"
      style="z-index:1"></video>
    <video
      class="video-field__v"
      data-vf-b
      muted
      playsinline
      preload="none"
      style="z-index:2; opacity:0"></video>
  </div>

  <!-- hue unification: hue+saturation from this ramp, luminance from the footage -->
  <div class="video-field__tint"></div>

  <!--
    The clip is 86.5% dark pixels, so a colour blend alone has almost no chroma
    to work with — over half the frame stays neutral. This screen pass lifts the
    shadows into dusk at the top and gold at the bottom so the palette reads.
  -->
  <div class="video-field__lift"></div>

  {presence && <div class="video-field__warm" data-vf-warm />}
  {veil && <div class="video-field__veil" />}
</div>

<style>
  .video-field {
    position: absolute;
    inset: 0;
    isolation: isolate;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1000ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .video-field[data-live="1"] {
    opacity: var(--vf-opacity, 1);
  }

  .video-field__stack {
    position: absolute;
    inset: 0;
    filter: saturate(var(--vf-sat, 1.15)) brightness(var(--vf-bri, 0.96)) contrast(1.06);
    transition: filter 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .video-field__v {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .video-field__tint {
    position: absolute;
    inset: 0;
    z-index: 3;
    mix-blend-mode: color;
    background: linear-gradient(
      to bottom,
      var(--color-dusk-800) 0%,
      var(--color-dusk-600) 34%,
      var(--color-gold-700) 76%,
      var(--color-coral-600) 100%
    );
  }

  .video-field__lift {
    position: absolute;
    inset: 0;
    z-index: 4;
    mix-blend-mode: screen;
    opacity: var(--vf-lift, 0.3);
    background: linear-gradient(
      to bottom,
      rgba(57, 76, 79, 0.95) 0%,
      rgba(41, 37, 47, 0.12) 46%,
      rgba(153, 114, 24, 0.8) 100%
    );
  }

  .video-field__warm {
    position: absolute;
    inset: 0;
    z-index: 5;
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 700ms ease;
    background: radial-gradient(
      420px circle at var(--vx, 50%) var(--vy, 50%),
      rgba(220, 167, 44, 0.3) 0%,
      rgba(220, 85, 44, 0.12) 42%,
      rgba(220, 167, 44, 0) 72%
    );
  }

  .video-field__veil {
    position: absolute;
    inset: 0;
    z-index: 6;
    background:
      radial-gradient(58% 46% at 50% 50%, rgba(23, 21, 27, 0.72) 0%, rgba(23, 21, 27, 0.35) 55%, rgba(23, 21, 27, 0) 82%),
      linear-gradient(to bottom, rgba(23, 21, 27, 0.85) 0%, rgba(23, 21, 27, 0.1) 28%, rgba(23, 21, 27, 0.1) 72%, rgba(23, 21, 27, 0.85) 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .video-field,
    .video-field__stack,
    .video-field__warm {
      transition: none;
    }
  }
</style>

<script>
  // One hoisted module drives every <VideoField> on the page.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const narrow = window.matchMedia("(max-width: 767px)").matches;

  document.querySelectorAll<HTMLElement>("[data-video-field]").forEach((field) => {
    const stack = field.querySelector<HTMLElement>(".video-field__stack");
    const warm = field.querySelector<HTMLElement>("[data-vf-warm]");
    const vA = field.querySelector<HTMLVideoElement>("[data-vf-a]");
    const vB = field.querySelector<HTMLVideoElement>("[data-vf-b]");
    if (!stack || !vA || !vB) return;

    const pace = Number(field.dataset.pace) || 0.8;
    const eager = field.dataset.eager === "1";
    const mobileSrc = field.dataset.mobileSrc || "";

    // On a phone, a lighter single-loop copy of the same footage if one was
    // given, no second decoder, no crossfade math, just native <video> loop.
    // No mobileSrc means the poster (already inside this same filtered/
    // tinted stack) stays in place instead of video, same as before.
    if (narrow) {
      if (reduceMotion || !mobileSrc) {
        field.dataset.live = "1";
        return;
      }
      vA.loop = true;
      vA.playbackRate = pace;
      let attached = false;
      const attach = () => {
        if (attached) return;
        attached = true;
        vA.preload = "auto";
        vA.src = mobileSrc;
      };
      vA.addEventListener(
        "playing",
        () => {
          field.dataset.live = "1";
        },
        { once: true }
      );
      if (eager) {
        attach();
      } else {
        const pre = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              attach();
              pre.disconnect();
            }
          },
          { rootMargin: "300px" }
        );
        pre.observe(field);
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              attach();
              void vA.play().catch(() => {});
            } else {
              vA.pause();
            }
          });
        },
        { threshold: 0.01 }
      );
      io.observe(field);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) vA.pause();
        else if (field.getBoundingClientRect().top < window.innerHeight) void vA.play().catch(() => {});
      });
      return;
    }

    const dissolve = Number(field.dataset.dissolve) || 1.1;
    const wantsPresence = field.dataset.presence === "1";
    const source = field.dataset.src || "";

    // The two copies used to load simultaneously, doubling the initial
    // payload. Now only the visible one loads up front; the crossfade copy
    // attaches once the first is actually playing.
    let primaryAttached = false;
    const attachPrimary = () => {
      if (primaryAttached || !source) return;
      primaryAttached = true;
      vA.preload = "auto";
      vA.src = source;
    };
    let secondaryAttached = false;
    const attachSecondary = () => {
      if (secondaryAttached || !source) return;
      secondaryAttached = true;
      vB.preload = "auto";
      vB.src = source;
    };

    const restSat = Number(getComputedStyle(field).getPropertyValue("--vf-sat")) || 1.15;
    const restBri = Number(getComputedStyle(field).getPropertyValue("--vf-bri")) || 0.96;

    let front: HTMLVideoElement = vA;
    let back: HTMLVideoElement = vB;
    let live = false;
    let visible = false;
    let rafId = 0;

    [vA, vB].forEach((v) => {
      v.loop = false;
      v.playbackRate = pace;
    });

    /* ---- presence ---- */
    if (wantsPresence && warm) {
      const host = field.parentElement;
      let idle: number | undefined;
      const rest = () => {
        stack.style.setProperty("--vf-sat", String(restSat));
        stack.style.setProperty("--vf-bri", String(restBri));
        warm.style.opacity = "0";
      };
      host?.addEventListener(
        "pointermove",
        (e) => {
          if (!live) return;
          const r = field.getBoundingClientRect();
          if (!r.width || !r.height) return;
          warm.style.setProperty("--vx", `${(((e.clientX - r.left) / r.width) * 100).toFixed(1)}%`);
          warm.style.setProperty("--vy", `${(((e.clientY - r.top) / r.height) * 100).toFixed(1)}%`);
          stack.style.setProperty("--vf-sat", String(Math.min(1.5, restSat + 0.35)));
          stack.style.setProperty("--vf-bri", String(Math.min(1.45, restBri + 0.3)));
          warm.style.opacity = "1";
          window.clearTimeout(idle);
          idle = window.setTimeout(rest, 1800);
        },
        { passive: true }
      );
    }

    /* ---- loop: dissolve between two copies across the wrap ---- */
    const swap = () => {
      back.style.zIndex = "1";
      back.style.opacity = "1";
      front.pause();
      front.currentTime = 0;
      front.style.zIndex = "2";
      front.style.opacity = "0";
      const prev = front;
      front = back;
      back = prev;
    };

    const tick = () => {
      if (!live || !visible) return;
      const d = front.duration;
      if (d && isFinite(d)) {
        const remaining = d - front.currentTime;
        if (remaining <= dissolve) {
          if (back.paused) {
            back.currentTime = 0;
            back.playbackRate = pace;
            void back.play().catch(() => {});
          }
          const t = Math.min(1, Math.max(0, 1 - remaining / dissolve));
          back.style.opacity = t.toFixed(3);
          if (t >= 1) swap();
        }
      }
      rafId = requestAnimationFrame(tick);
    };

    [vA, vB].forEach((v) => {
      v.addEventListener("ended", () => {
        if (!live) return;
        if (v === front) swap();
        else {
          v.pause();
          v.currentTime = 0;
        }
      });
    });

    const goLive = () => {
      if (live) return;
      live = true;
      field.dataset.live = "1";
      if (visible) rafId = requestAnimationFrame(tick);
    };

    if (reduceMotion) {
      // no playback; a loaded, paused video holds its first frame. One copy
      // is all reduced-motion ever needs.
      const hold = () => {
        if (vA.readyState >= 2) goLive();
        else vA.addEventListener("loadeddata", goLive, { once: true });
      };
      if (eager) {
        attachPrimary();
        hold();
      } else {
        const once = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              attachPrimary();
              hold();
              once.disconnect();
            }
          },
          { rootMargin: "200px" }
        );
        once.observe(field);
      }
      return;
    }

    vA.addEventListener(
      "playing",
      () => {
        goLive();
        attachSecondary();
      },
      { once: true }
    );

    /* ---- attach the primary copy just before it's needed ---- */
    if (eager) {
      attachPrimary();
    } else {
      const pre = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            attachPrimary();
            pre.disconnect();
          }
        },
        { rootMargin: "300px" }
      );
      pre.observe(field);
    }

    /* ---- only decode while on screen ---- */
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          visible = entry.isIntersecting;
          if (visible) {
            attachPrimary();
            void front.play().catch(() => {});
            cancelAnimationFrame(rafId);
            if (live) rafId = requestAnimationFrame(tick);
          } else {
            cancelAnimationFrame(rafId);
            vA.pause();
            vB.pause();
          }
        });
      },
      { threshold: 0.01 }
    );
    io.observe(field);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
        vA.pause();
        vB.pause();
      } else if (visible) {
        void front.play().catch(() => {});
        if (live) rafId = requestAnimationFrame(tick);
      }
    });
  });
</script>
