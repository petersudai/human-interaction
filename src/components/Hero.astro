---
import HeroContent from "./HeroContent";
import VideoField from "./VideoField.astro";
import { hero } from "../data/content";

const leadWords = hero.headlineLead.split(" ");
const tailWords = hero.headlineTail.split(" ");
---

<section id="top" class="grain relative flex h-[100svh] items-center overflow-hidden pt-20 pb-12">
  <!--
    Held darker than the default so the headline reads. `lift` is pulled down
    too: that pass brightens the shadows, which is exactly the contrast the
    cream type needs. Saturation is nudged up to keep the colour from going
    flat at the lower brightness.
  -->
  <VideoField
    eager
    presence
    veil
    brightness={0.7}
    lift={0.2}
    saturate={1.2}
    poster="/hero-poster.jpg"
    mobileSrc="/hero-video-mobile.webm"
  />

  <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center px-5 text-center">
    <!--
      Eyebrow, headline, and subheading are static Astro markup, not a React
      island: this is the mobile LCP content, and gating its first paint
      behind JS download/hydration was directly costing render-delay time in
      Lighthouse. The kinetic word reveal is now a pure CSS animation, so it
      still plays but never blocks the text from being paintable immediately.
    -->
    <span
      class="hero-reveal mb-5 inline-flex items-center gap-2 rounded-full border border-ink-border bg-ink-2/60 px-4 py-1.5 text-xs font-medium uppercase tracking-[0.15em] text-gold-300 sm:mb-6"
      style="animation-delay: 0.1s"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-gold-400" />
      {hero.eyebrow}
    </span>

    <h1 class="text-balance font-display text-[12vw] leading-[1.05] tracking-tight text-cream sm:text-6xl sm:leading-[1.03] md:text-7xl lg:text-[5.25rem]">
      <span class="sr-only">{hero.headlineLead} {hero.headlineEmphasis} {hero.headlineTail}</span>
      <span aria-hidden="true">
        {leadWords.map((w, i) => (
          <span class="mr-[0.28em] inline-block overflow-hidden pb-1 align-bottom last:mr-0">
            <span class="hero-word inline-block" style={`animation-delay: ${0.5 + i * 0.05}s`}>{w}</span>
          </span>
        ))}
        <span class="mr-[0.28em] inline-block overflow-hidden pb-1 align-bottom last:mr-0">
          <span
            class="hero-word inline-block text-shimmer bg-clip-text italic text-transparent"
            style={`animation-delay: ${0.5 + leadWords.length * 0.05}s`}
          >
            {hero.headlineEmphasis}
          </span>
        </span>
        {tailWords.map((w, i) => (
          <span class="mr-[0.28em] inline-block overflow-hidden pb-1 align-bottom last:mr-0">
            <span
              class="hero-word inline-block"
              style={`animation-delay: ${0.5 + (leadWords.length + 1 + i) * 0.05}s`}
            >
              {w}
            </span>
          </span>
        ))}
      </span>
    </h1>

    <p class="mt-5 max-w-2xl text-balance text-base leading-relaxed text-dusk-100/85 sm:mt-7 sm:text-lg md:text-xl">
      {hero.sub}
    </p>

    <HeroContent client:idle />
  </div>

  <div class="absolute bottom-8 left-1/2 z-10 hidden -translate-x-1/2 text-dusk-200/50 [@media(min-height:700px)]:block">
    <div class="h-9 w-px animate-pulse bg-current"></div>
  </div>
</section>

<style>
  @keyframes hero-reveal-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-word-in {
    from {
      transform: translateY(115%);
    }
    to {
      transform: translateY(0%);
    }
  }

  .hero-reveal {
    animation: hero-reveal-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-word {
    animation: hero-word-in 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal,
    .hero-word {
      animation: none;
    }
  }
</style>
