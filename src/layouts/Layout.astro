---
import "../styles/global.css";
import BackToTop from "../components/BackToTop";
import { contact, gaMeasurementId } from "../data/content";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Human Interaction | Web & software built to sell",
  description = "Human Interaction designs and builds fast, high-end websites and software for ambitious businesses, creatives, and founders, wherever they're based.",
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const logoUrl = new URL("/logo.png", Astro.site);

// ProfessionalService structured data. Keep the entity intentionally generic
// (no legal name, no street address) — matches how the rest of the copy
// stays quiet about company structure.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Human Interaction",
  url: Astro.site?.toString(),
  logo: logoUrl.toString(),
  image: logoUrl.toString(),
  description,
  email: contact.email,
  telephone: "+14709523286",
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Atlanta",
    addressRegion: "GA",
    addressCountry: "US",
  },
  areaServed: ["United States", "Worldwide"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
    <link rel="canonical" href={pageUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#17151b" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Human Interaction" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={logoUrl} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={logoUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    {
      gaMeasurementId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
          <script define:vars={{ gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaMeasurementId);
          </script>
        </>
      )
    }

    <!-- .reveal starts at opacity 0 and is un-hidden by script. Without JS that
         would hide most of the page, so opt out entirely. -->
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <slot />
    <BackToTop client:load />
    <script src="https://assets.calendly.com/assets/external/widget.js" async></script>

    <script>
      // Scroll reveal — one observer for every .reveal on the page, replacing
      // what used to be a React island each.
      const revealIO = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in");
              revealIO.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "0px 0px -80px 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => revealIO.observe(el));
    </script>

    <script>
      // Presence — one delegated listener for every .presence surface on the
      // page. Adding the effect to a new component is just the class.
      document.addEventListener(
        "pointermove",
        (e) => {
          const target = e.target;
          if (!(target instanceof Element)) return;
          const el = target.closest<HTMLElement>(".presence");
          if (!el) return;
          const rect = el.getBoundingClientRect();
          if (!rect.width || !rect.height) return;
          el.style.setProperty("--px", `${(((e.clientX - rect.left) / rect.width) * 100).toFixed(1)}%`);
          el.style.setProperty("--py", `${(((e.clientY - rect.top) / rect.height) * 100).toFixed(1)}%`);
        },
        { passive: true }
      );
    </script>

    <script define:vars={{ bookingUrl: contact.bookingUrl }}>
      // Book-a-call links keep their real href (progressive enhancement, and
      // middle-click/ctrl-click still opens Calendly in a new tab as normal).
      // Once the widget script has loaded, a plain left-click opens Calendly's
      // popup overlay instead so people never leave the page. The same click
      // also fires a GA4 event if analytics is wired up.
      document.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;
        const el = target.closest("[data-ga-event], [data-calendly]");
        if (!el) return;

        const eventName = el.getAttribute("data-ga-event");
        if (eventName && typeof window.gtag === "function") {
          const tier = el.getAttribute("data-ga-tier");
          window.gtag("event", eventName, tier ? { tier } : {});
        }

        if (el.hasAttribute("data-calendly")) {
          const modified = e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey;
          if (!modified && typeof window.Calendly !== "undefined") {
            e.preventDefault();
            window.Calendly.initPopupWidget({ url: el.getAttribute("href") || bookingUrl });
          }
        }
      });
    </script>
  </body>
</html>
